# ==============================================================================
# Agentic Dating Platform - Environment Variables
# ==============================================================================

# Simulation Mode: "deterministic" (default, zero-cost, instant, reproducible) or "gemini"
SIMULATION_MODE=deterministic

# Optional: Google Gemini API key if using real LLM simulation mode
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Maximum concurrency for LLM agent simulation batching
MAX_CONCURRENCY=5

# Port
PORT=3000
